{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"r2_buckets": [
		{
			"bucket_name": "inxizang-bucket",
			"binding": "inxizang_bucket",
			"remote": false
		}
	],
	  
	"d1_databases": [
		{
			"binding": "inxizang_db",
			"database_name": "inxizang-db",
			"database_id": "96616f96-1ef4-4dc7-a592-8d8633789ef5",
			"remote": false,
			"migrations_dir": "./drizzle",
		}
	]
}